#!/usr/bin/env python3
import json, html, re
from pathlib import Path

# ---- Paths / Policy ----
ROOT = Path(__file__).parent.resolve()
DATA = ROOT / "assets" / "data" / "items.json"
OUT_GALLERY = ROOT / "gallery"
OUT_GALLERY.mkdir(parents=True, exist_ok=True)

# 表示ポリシー
SHOW_BREADCRUMB = False
SHOW_SPECS      = True   # Stone / Carat / Design の3点のみ表示

# ---- Partials ----
INTRO = ROOT / "assets" / "partials" / "top_intro.html"
CTA   = ROOT / "assets" / "partials" / "top_cta.html"

def read_intro():
    return INTRO.read_text(encoding="utf-8") if INTRO.exists() else ""

def read_cta():
    return CTA.read_text(encoding="utf-8") if CTA.exists() else ""

# ---- Data ----
def read_items():
    items = json.loads(DATA.read_text(encoding="utf-8"))
    # 新しい順（date がない場合は末尾）
    items.sort(key=lambda x: x.get("date",""), reverse=True)
    return items

# ---- Image helpers ----
def image_suffixes(slug: str, kind: str):
    """
    対応パターン:
      slug-cover.jpg / .webp
      slug-DSC_4975.jpg, slug-DSC4975.jpg, slug-IMG_1234.JPG など
      旧: slug.jpg / slug.webp
    """
    folder = ROOT / "assets" / "images" / kind
    if not folder.exists():
        return []

    # プレフィックス許容（Nikon等のアンダースコアに対応）
    prefixes = [slug, slug.replace("-", "_")]

    # 受け入れる拡張子
    exts = (".jpg", ".jpeg", ".webp", ".png", ".JPG", ".JPEG", ".WEBP", ".PNG")

    found = []
    for p in folder.iterdir():
        if not p.is_file():
            continue
        name = p.name
        low  = name.lower()
        if not low.endswith(tuple(e.lower() for e in exts)):
            continue
        # prefix マッチ
        if any(low.startswith(pref.lower()+"-") or low == (pref.lower()+low[ len(pref): ]) for pref in prefixes):
            # suffix を抽出（slug-XXXX.ext → XXXX）
            # ハイフン区切り：slug-xxxx.ext
            for pref in prefixes:
                if name.startswith(pref + "-"):
                    suf = name[len(pref)+1:name.rfind(".")]
                    found.append(suf)
                    break
            else:
                # 旧: suffix なし（slug.jpg）
                if name.lower().startswith(slug.lower()+".") or name.lower().startswith(slug.replace("-", "_").lower()+"."):
                    found.append("")  # suffix なし
    if not found:
        return []
    # cover を先頭、それ以外は辞書順
    found = sorted(found, key=lambda s: (s.lower() != "cover", s.lower()))
    # 重複除去（順序保持）
    seen, uniq = set(), []
    for s in found:
        if s not in seen:
            seen.add(s); uniq.append(s)
    return uniq

def img_path(slug: str, folder: str, suf: str) -> str:
    # folder: "thumb" or "4k"
    base = f"/assets/images/{folder}"
    return f"{base}/{slug}{suf}"

def primary_images(slug: str):
    """一覧カード用thumb と、詳細での最初の4K"""
    sufs = image_suffixes(slug, "thumb")
    if not sufs:
        return (None, None)
    s = sufs[0]
    return (img_path(slug, "thumb", s), img_path(slug, "4k", s))

def all_images(slug: str):
    """サムネ用フォルダから slug（ハイフン/アンダースコア両対応）で始まるファイルを列挙。絶対パスで返す。"""
    thumb_dir = ROOT / "assets" / "images" / "thumb"
    if not thumb_dir.exists():
        return []

    want_prefixes = [slug.lower(), slug.lower().replace("-", "_")]
    exts = (".jpg", ".jpeg", ".webp", ".png", ".JPG", ".JPEG", ".WEBP", ".PNG")

    found = []
    for p in thumb_dir.iterdir():
        if not p.is_file():
            continue
        name = p.name
        low = name.lower()
        if low.endswith(exts) and any(low.startswith(pref) for pref in want_prefixes):
            # 生成物からの参照は常にルート起点
            found.append(f"/assets/images/thumb/{name}")

    # primary を先頭に（重複は除く）
    primary_thumb, _ = primary_images(slug)
    if primary_thumb and primary_thumb in found:
        found.remove(primary_thumb)
        found.insert(0, primary_thumb)

    return found

# ---- Templates ----
def card_html(it):
    """Rara Lab ギャラリー用の最小出力（figure）"""
    slug   = it["slug"]
    stone  = it.get("stone","")
    carat  = it.get("carat","")
    design = it.get("design_name","")

    primary = f"{stone} – {carat}ct" if stone and carat else (stone or slug)
    secondary = f"“{design}”" if design else ""

    thumb, _ = primary_images(slug)
    img_tag = f'<img src="{thumb}" alt="{html.escape(primary + (" " + secondary if secondary else ""))}" loading="lazy" decoding="async">' if thumb else ""

    # クリックで個別へ
    return f'''<figure class="rl-item">
  <a href="/gallery/{slug}/" class="rl-link">
    {img_tag}
    <figcaption class="rl-caption">
      <span class="primary">{html.escape(primary)}</span>
      <span class="secondary">{html.escape(secondary)}</span>
    </figcaption>
  </a>
</figure>'''

def gallery_index_html(cards: str) -> str:
    return f'''<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Gallery – Rara Lab</title>
<link rel="stylesheet" href="/assets/css/site.css">
<section class="rl-gallery">
{cards}
</section>
'''

def top_index_html(new_cards: str) -> str:
    return f'''<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Rara Lab</title>
<link rel="stylesheet" href="/assets/css/site.css">
<section class="intro">
{read_intro()}
{read_cta()}
</section>
<section class="rl-gallery">
{new_cards}
</section>
'''

def detail_html(it):
    slug   = it["slug"]
    stone  = it.get("stone","")
    carat  = it.get("carat","")
    design = it.get("design_name","")

    # 見出し（先に定義）
    title    = f'{stone} – {carat}ct' if stone and carat else (stone or slug)
    subtitle = f'“{design}”' if design else ''

    # パンくず（必要ならON）
    breadcrumb = '' if not SHOW_BREADCRUMB else '<nav class="breadcrumb"><a href="/gallery/">← Back to Gallery</a></nav>'

    # ---- 画像 ----
    hero_thumb, hero_4k = primary_images(slug)
    thumbs = all_images(slug)

    # ヒーロー画像（クリックで4K）
    if not hero_thumb and thumbs:
        hero_thumb = thumbs[0]
    hero_link = (hero_4k or (hero_thumb or "")).replace("/thumb/", "/4k/")
    hero_img  = hero_thumb or hero_4k or ""
    hero_html = ""
    if hero_img:
        hero_html = f'''
        <a href="{hero_link}" target="_blank" rel="noopener">
          <img class="hero" src="{hero_img}" alt="{html.escape(title)}">
        </a>'''.strip()

    # サムネ一覧（すべて4Kへリンク）
    thumbs_html = ""
    if thumbs:
        items = []
        for t in thumbs:
            f4k = t.replace("/thumb/", "/4k/")
            items.append(
                f'<a class="thumb" href="{f4k}" target="_blank" rel="noopener"><img src="{t}" alt="{html.escape(title)}"></a>'
            )
        thumbs_html = '<div class="thumbs">\n' + "\n".join(items) + "\n</div>"

    # スペック（最小3点）
    spec_html = ""
    if SHOW_SPECS:
        spec_items = []
        if stone:  spec_items.append(f'<li><strong>Stone:</strong> {html.escape(stone)}</li>')
        if carat:  spec_items.append(f'<li><strong>Carat:</strong> {html.escape(str(carat))}ct</li>')
        if design: spec_items.append(f'<li><strong>Design:</strong> {html.escape(design)}</li>')
        spec_html = f'<section class="spec"><ul>{"".join(spec_items)}</ul></section>'

    # 出力
    return f'''<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{html.escape(title)} – Rara Lab</title>
<link rel="stylesheet" href="/assets/css/site.css">
<main class="detail">
  {breadcrumb}
  <h1 class="title">{html.escape(title)}</h1>
  {'<h2 class="subtitle">'+html.escape(subtitle)+'</h2>' if subtitle else ''}
  <section class="hero">
    {hero_html}
  </section>
  {thumbs_html}
  {spec_html}
</main>
'''

# ---- Build ----
def build():
    items = read_items()

    # 一覧（gallery/index.html）
    cards = "\n".join([card_html(it) for it in items])
    (OUT_GALLERY / "index.html").write_text(gallery_index_html(cards), encoding="utf-8")

    # 各詳細
    for it in items:
        d = OUT_GALLERY / it["slug"]
        d.mkdir(parents=True, exist_ok=True)
        (d / "index.html").write_text(detail_html(it), encoding="utf-8")

    # トップ（新着12件）
    newest = items[:12]
    new_cards = "\n".join([card_html(it) for it in newest])
    (ROOT / "index.html").write_text(top_index_html(new_cards), encoding="utf-8")

if __name__ == "__main__":
    build()
    print("✅ build complete: gallery, details, and top index generated.")