:"61a18bb7bd363129ee6d1dec","systemDataId":"1662982546495-N4GBAJXEZZH0COPBSLNH","systemDataVariants":"1080x1080,100w,300w,500w,750w,1000w","systemDataSourceType":"JPG","filename":"dragonfly.jpg","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"4f7416","topRightAverage":"5e8728","bottomLeftAverage":"374c08","bottomRightAverage":"4e6c11","centerAverage":"67852f","suggestedBgColor":"5b7d22"},"urlId":"220910-email-issue","title":"\u3010\u89E3\u6C7A\u6E08\u307F\u3011\u30E1\u30FC\u30EB\u306E\u4E0D\u5177\u5408","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-631b7abc7ed8095ecef947a9\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-border-radii=\"&#123;&quot;topLeft&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;topRight&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;bottomLeft&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;bottomRight&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;&#125;\" data-sqsp-block=\"text\" id=\"block-yui_3_17_2_1_1662982515009_2146\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <h4 style=\"white-space:pre-wrap;\">\u3010\u66F4\u65B0\u301122.09.20<br>\u30E1\u30FC\u30EB\u306E\u4E0D\u5177\u5408\u306B\u3064\u3044\u3066\u3001\u3059\u3079\u3066\u89E3\u6C7A\u3044\u305F\u3057\u307E\u3057\u305F\u3002</h4><p class=\"\" style=\"white-space:pre-wrap;\">\u30FB\u4E00\u90E8\u306E\u30C9\u30E1\u30A4\u30F3\u3067\u3001Rara Lab\u304B\u3089\u306E\u30E1\u30FC\u30EB\u304C\u5C4A\u304B\u306A\u3044\u30FB\u8FF7\u60D1\u30E1\u30FC\u30EB\u306B\u632F\u308A\u5206\u3051\u3089\u308C\u308B\u73FE\u8C61\u306B\u3064\u3044\u3066\u3001\u3059\u3079\u3066\u89E3\u6C7A\u3044\u305F\u3057\u307E\u3057\u305F\u3002</p><p class=\"\" style=\"white-space:pre-wrap;\">\u30FB9/12\u301C9/20\u307E\u3067\u306E\u9593\u3001\u304A\u5BA2\u69D8\u304B\u3089\u306E\u30E1\u30FC\u30EB\u3068\u554F\u3044\u5408\u308F\u305B\u304C\u5C4A\u304B\u306A\u304B\u3063\u305F\u53EF\u80FD\u6027\u304C\u3042\u308A\u307E\u3059\u3002</p><p class=\"\" style=\"white-space:pre-wrap;\">-\u30E1\u30FC\u30EB\u3092\u3053\u306E\u671F\u9593\u306B\u9001\u4FE1\u3057\u3001Rara Lab\u304B\u3089\u306E\u8FD4\u4E8B\u304C\u306A\u3044\u304A\u5BA2\u69D8\u306F\u3001\u304A\u624B\u6570\u3092\u304A\u304B\u3051\u3057\u307E\u3059\u304C\u3001\u3082\u3046\u4E00\u5EA6\u3054\u9023\u7D61\u3044\u305F\u3060\u3051\u307E\u3059\u3067\u3057\u3087\u3046\u304B\u3002</p><p class=\"\" style=\"white-space:pre-wrap;\">-\u304A\u554F\u3044\u5408\u308F\u305B\u30D5\u30A9\u30FC\u30E0\u3092\u3053\u306E\u671F\u9593\u306B\u3054\u5229\u7528\u304F\u3060\u3055\u3063\u305F\u304A\u5BA2\u69D8\u3082\u3001\u304A\u624B\u6570\u3067\u3059\u304C\u3001\u3082\u3046\u4E00\u5EA6\u3054\u9023\u7D61\u3044\u305F\u3060\u3051\u307E\u3059\u3067\u3057\u3087\u3046\u304B\u3002</p><p class=\"\" style=\"white-space:pre-wrap;\">\u304A\u5BA2\u69D8\u306B\u306F\u3054\u4E0D\u4FBF\u3092\u304A\u304B\u3051\u3044\u305F\u3057\u307E\u3057\u305F\u3002<br>\u3054\u5354\u529B\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3057\u305F\uFF01</p><p class=\"\" style=\"white-space:pre-wrap;\">\u30FB\u30FB\u30FB\u30FB\u30FB</p><p class=\"\" style=\"white-space:pre-wrap;\">22.09.12\u2061</p><p class=\"\" style=\"white-space:pre-wrap;\">\u30E1\u30FC\u30EB\u30B5\u30FC\u30D0\u30FC\u306E\u9001\u4FE1\u30A8\u30E9\u30FC\u306B\u3064\u3044\u3066\u3001\u307B\u307C\u5FA9\u65E7\u3057\u307E\u3057\u305F\u3002</p><p class=\"\" style=\"white-space:pre-wrap;\">\u4E00\u90E8\u306E\u30E1\u30FC\u30EB\u30C9\u30EC\u30B9\u306B\u3064\u3044\u3066\u3001Rara Lab\u304B\u3089\u306E\u30E1\u30FC\u30EB\u304C\u8FF7\u60D1\u30E1\u30FC\u30EB\u306B\u306A\u3063\u3066\u3057\u307E\u3046\u3053\u3068\u304C\u3042\u308B\u3088\u3046\u3067\u3059\u3002\u3053\u308C\u306B\u3064\u3044\u3066Rara Lab\u3067\u306F\u3001\u5F15\u304D\u7D9A\u304D\u89E3\u6C7A\u306B\u5411\u3051\u3066\u53D6\u308A\u7D44\u3093\u3067\u304A\u308A\u307E\u3059\u3002</p><p class=\"\" style=\"white-space:pre-wrap;\">\u304A\u5BA2\u3055\u307E\u306B\u306F\u304A\u624B\u6570\u3092\u304A\u304B\u3051\u3057\u307E\u3059\u3002<br>\u3044\u3064\u3082\u3042\u305F\u305F\u304B\u3044\u30B5\u30DD\u30FC\u30C8\u3092\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\uFF01</p><p class=\"\" style=\"white-space:pre-wrap;\">2022.09.10</p><p class=\"\" style=\"white-space:pre-wrap;\">\u305F\u3060\u3044\u307ERara Lab\u306E\u30E1\u30FC\u30EB\u30B5\u30FC\u30D0\u30FC\u306B\u969C\u5BB3\u304C\u767A\u751F\u3057\u3066\u304A\u308A\u307E\u3059\u3002<br>\u307E\u305F\u3001\u521D\u3081\u3066\u306E\u304A\u5BA2\u69D8\u3084\u304A\u6025\u304E\u306E\u304A\u5BA2\u69D8\u306F\u3001\u304A\u624B\u6570\u3067\u3059\u304CInstagram\u3001\u307E\u305F\u306FTwitter\u306EDM\u304B\u3089\u3054\u9023\u7D61\u304F\u3060\u3055\u3044\u3002</p><p class=\"\" style=\"white-space:pre-wrap;\">\u3054\u8FF7\u60D1\u3092\u304A\u304B\u3051\u3057\u3066\u7533\u3057\u8A33\u3054\u3056\u3044\u307E\u305B\u3093\u3002<br>\u307F\u306A\u3055\u307E\u306E\u3054\u5354\u529B\u306B\u611F\u8B1D\u3044\u305F\u3057\u307E\u3059\u3002</p><p class=\"\" style=\"white-space:pre-wrap;\">\u2606\u2606\u2606\u2606\u2606</p><h4 style=\"white-space:pre-wrap;\">\u3010UPDATED\u30112022.09.20</h4><p class=\"\" style=\"white-space:pre-wrap;\">The email issues are all solved. Thank you for your cooperation!</p><p class=\"\" style=\"white-space:pre-wrap;\">We have found that the email and contact form didn't work properly from 12th, Sep - 20th, Sep. If you haven't received a reply from us during this period, please reach us again.</p><p class=\"\" style=\"white-space:pre-wrap;\">Thank you for your support!</p><p class=\"\" style=\"white-space:pre-wrap;\">22.09.12</p><p class=\"\" style=\"white-space:pre-wrap;\">The email error is almost solved!</p><p class=\"\" style=\"white-space:pre-wrap;\">If you don't get an email from us, please check your spam folder.<br>(We are working on this issue)</p><p class=\"\" style=\"white-space:pre-wrap;\">Thank you for your warm support!</p><p class=\"\" style=\"white-space:pre-wrap;\">22.09.10</p><p class=\"\" style=\"white-space:pre-wrap;\">We have an issue with our mail server now. We are working to solve the problem. For new customers, please reach us via Instagram or Twitter and DM us.</p><p class=\"\" style=\"white-space:pre-wrap;\">We apologize for the inconvenience. Thank you for your cooperation.</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block image-block sqs-block-image\" data-block-type=\"5\" id=\"block-yui_3_17_2_1_1662984164571_3104\"><div class=\"sqs-block-content\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n\n    \n  \n    <div\n        class=\"\n          image-block-outer-wrapper\n          layout-caption-below\n          design-layout-inline\n          combination-animation-site-default\n          individual-animation-site-default\n          individual-text-animation-site-default\n        \"\n        data-test=\"image-block-inline-outer-wrapper\"\n    >\n\n      \n\n      \n        <figure\n            class=\"\n              sqs-block-image-figure\n              intrinsic\n            \"\n            style=\"max-width:1080px;\"\n        >\n          \n        \n        \n\n        \n          \n            \n          <div\n              \n              \n              class=\"image-block-wrapper\"\n              data-animation-role=\"image\"\n              \n  \n\n          >\n            <div class=\"sqs-image-shape-container-element\n              \n          \n        \n              has-aspect-ratio\n            \" style=\"\n                position: relative;\n                \n                  padding-bottom:100%;\n                \n                overflow: hidden;-webki